# slim means its a trimmed down version of node 22
# alpine means is based on minimalistic linux distribution and has fewer security vulnerabilities
FROM node:22-slim

WORKDIR /app
COPY package*.json .

# Install only dependencies that are needed (exclude devDependencies)
# --only=production
RUN npm ci --only=production

COPY index.js index.js

CMD ["node", "index.js"]